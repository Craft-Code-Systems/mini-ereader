#VRML V2.0 utf8
# Simplified stand-in body for a 4-pin SIDE-ACTUATED SMD tactile switch
# (TS-1187A / YD-3414 class, ~4.7 x 3.5 x 3.5 mm, actuator on +X face).
# Authored in millimetres; the footprint references this with
# scale 0.3937 (= 1/2.54) so KiCad renders it 1:1 in mm.
# NOT a datasheet-accurate model - replace with the vendor STEP/WRL before fab.

# --- switch body (black) ---
Transform {
  translation 0 0 1.25
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.12 0.12 0.12 } }
      geometry Box { size 4.7 3.5 2.5 }
    }
  ]
}
# --- side actuator button (light grey, protrudes +X) ---
Transform {
  translation 2.85 0 1.4
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.78 0.78 0.78 } }
      geometry Box { size 1.0 1.8 1.2 }
    }
  ]
}
