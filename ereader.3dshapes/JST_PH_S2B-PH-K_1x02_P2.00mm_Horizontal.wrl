#VRML V2.0 utf8
# Simplified project-local 3D stand-in for a JST PH 2-pin side-entry header (J5, battery).
# Authored in mm; the footprint references it with scale 0.3937 (= 1/2.54)
# so KiCad renders it 1:1 and the board shows in the 3D viewer WITHOUT
# KiCad's stock 3D libraries. NOT a full mechanical model.

# --- nylon housing ---
Transform {
  translation 1 2.45 2.25
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.88 0.88 0.85 } }
      geometry Box { size 5.9 7.6 4.5 }
    }
  ]
}
# --- wire-entry mouth (front) ---
Transform {
  translation 1 -1.05 2
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } }
      geometry Box { size 5 0.6 3.4 }
    }
  ]
}
