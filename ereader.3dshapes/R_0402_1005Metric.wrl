#VRML V2.0 utf8
# Simplified project-local 3D stand-in for a 0402 chip resistor (1.0 x 0.5 x 0.35 mm).
# Authored in mm; the footprint references it with scale 0.3937 (= 1/2.54)
# so KiCad renders it 1:1 and the board shows in the 3D viewer WITHOUT
# KiCad's stock 3D libraries. NOT a full mechanical model.

# --- terminal (left) ---
Transform {
  translation -0.42 0 0.18
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.86 0.72 0.45 } }
      geometry Box { size 0.25 0.5 0.36 }
    }
  ]
}
# --- terminal (right) ---
Transform {
  translation 0.42 0 0.18
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.86 0.72 0.45 } }
      geometry Box { size 0.25 0.5 0.36 }
    }
  ]
}
# --- resistive body ---
Transform {
  translation 0 0 0.2
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.13 0.13 0.13 } }
      geometry Box { size 0.6 0.5 0.36 }
    }
  ]
}
