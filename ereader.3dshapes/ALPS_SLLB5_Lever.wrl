#VRML V2.0 utf8
# Simplified stand-in body for the ALPS SLLB5 multi-directional lever switch
# (SLLB510200 / SLLB510100, ~9.5 x 8.8 x 2.2 mm body + upright lever).
# Authored in millimetres; the footprint references this with
# scale 0.3937 (= 1/2.54) so KiCad renders it 1:1 in mm.
# NOT a datasheet-accurate model - replace with the ALPS STEP/WRL before fab.

# --- switch body (dark grey) ---
Transform {
  translation 0 0 1.1
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.16 0.16 0.16 } }
      geometry Box { size 8.8 9.5 2.2 }
    }
  ]
}
# --- upright lever (yellow-ish) ---
Transform {
  translation 0 0 3.7
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.80 0.72 0.20 } }
      geometry Box { size 1.6 1.6 3.0 }
    }
  ]
}
