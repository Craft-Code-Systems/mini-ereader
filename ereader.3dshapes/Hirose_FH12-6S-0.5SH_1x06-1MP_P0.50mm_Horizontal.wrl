#VRML V2.0 utf8
# Simplified project-local 3D stand-in for a Hirose FH12-6S 0.5 mm FPC ZIF connector (J3, frontlight).
# Authored in mm; the footprint references it with scale 0.3937 (= 1/2.54)
# so KiCad renders it 1:1 and the board shows in the 3D viewer WITHOUT
# KiCad's stock 3D libraries. NOT a full mechanical model.

# --- ZIF housing ---
Transform {
  translation 0 1.6 0.5
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.18 0.18 0.2 } }
      geometry Box { size 6.1 5.6 1 }
    }
  ]
}
# --- flip-lock actuator (raised) ---
Transform {
  translation 0 3.9 0.75
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.24 0.24 0.24 } }
      geometry Box { size 6.1 1.4 1.1 }
    }
  ]
}
