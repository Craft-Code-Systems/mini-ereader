#VRML V2.0 utf8
# Simplified project-local 3D stand-in for the ESP32-S3-WROOM-1 module (18 x 25.5 x 3.2 mm).
# Authored in mm; the footprint references it with scale 0.3937 (= 1/2.54)
# so KiCad renders it 1:1 and the board shows in the 3D viewer WITHOUT
# KiCad's stock 3D libraries. NOT a full mechanical model.

# --- module PCB ---
Transform {
  translation 0 0 0.4
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.2 0.45 0.2 } }
      geometry Box { size 18 25.5 0.8 }
    }
  ]
}
# --- RF shield can ---
Transform {
  translation 0 3.75 2
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.6 0.62 0.66 } }
      geometry Box { size 17.2 17.5 2.4 }
    }
  ]
}
# --- PCB antenna area (keep-out) ---
Transform {
  translation 0 -9 0.85
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.75 0.72 0.6 } }
      geometry Box { size 16 5.6 0.85 }
    }
  ]
}
