#VRML V2.0 utf8
# Simplified project-local 3D stand-in for a 0603 MLCC capacitor.
# Authored in mm; the footprint references it with scale 0.3937 (= 1/2.54)
# so KiCad renders it 1:1 and the board shows in the 3D viewer WITHOUT
# KiCad's stock 3D libraries. NOT a full mechanical model.

# --- terminal ---
Transform {
  translation -0.7 0 0.4
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.6 0.62 0.66 } }
      geometry Box { size 0.2 0.8 0.72 }
    }
  ]
}
# --- terminal ---
Transform {
  translation 0.7 0 0.4
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.6 0.62 0.66 } }
      geometry Box { size 0.2 0.8 0.72 }
    }
  ]
}
# --- ceramic body ---
Transform {
  translation 0 0 0.4
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.8 0.69 0.48 } }
      geometry Box { size 1.3 0.8 0.8 }
    }
  ]
}
