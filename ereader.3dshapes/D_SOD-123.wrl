#VRML V2.0 utf8
# Simplified project-local 3D stand-in for a SOD-123 diode (2.7 x 1.5 x 1.1 mm).
# Authored in mm; the footprint references it with scale 0.3937 (= 1/2.54)
# so KiCad renders it 1:1 and the board shows in the 3D viewer WITHOUT
# KiCad's stock 3D libraries. NOT a full mechanical model.

# --- lead (cathode/pin1) ---
Transform {
  translation -1.35 0 0.45
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.6 0.62 0.66 } }
      geometry Box { size 0.5 1.3 0.9 }
    }
  ]
}
# --- lead (anode/pin2) ---
Transform {
  translation 1.35 0 0.45
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.6 0.62 0.66 } }
      geometry Box { size 0.5 1.3 0.9 }
    }
  ]
}
# --- body ---
Transform {
  translation 0 0 0.55
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.13 0.13 0.13 } }
      geometry Box { size 2.7 1.5 1.1 }
    }
  ]
}
# --- cathode band ---
Transform {
  translation -1 0 0.56
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.85 0.85 0.85 } }
      geometry Box { size 0.25 1.52 1.12 }
    }
  ]
}
