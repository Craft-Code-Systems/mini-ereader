#VRML V2.0 utf8
# Simplified stand-in for Wurth WS-TASU 436351045816 side-push tact switch
# (4.7 x 3.5 x 1.65 mm, side actuator on +Y, boss pins on the underside).
# Authored in mm; footprint references it with scale 0.3937 (= 1/2.54)
# so KiCad renders it 1:1. NOT a full mechanical model.

# --- switch body (black) ---
Transform {
  translation 0 0 0.825
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.12 0.12 0.12 } }
      geometry Box { size 4.7 3.5 1.65 }
    }
  ]
}
# --- side actuator (white PA46 per datasheet), protrudes +Y ---
Transform {
  translation 0 2.05 0.9
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.9 0.9 0.9 } }
      geometry Box { size 1.6 0.7 0.9 }
    }
  ]
}
