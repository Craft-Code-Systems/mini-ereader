#VRML V2.0 utf8
# Simplified project-local 3D stand-in for a USB-C receptacle (J1, HRO TYPE-C-31-M-12).
# Authored in mm; the footprint references it with scale 0.3937 (= 1/2.54)
# so KiCad renders it 1:1 and the board shows in the 3D viewer WITHOUT
# KiCad's stock 3D libraries. NOT a full mechanical model.

# --- metal shell ---
Transform {
  translation 0 0.35 1.58
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.72 0.73 0.75 } }
      geometry Box { size 8.94 6.6 3.16 }
    }
  ]
}
# --- tongue cavity (front, board edge) ---
Transform {
  translation 0 -1.2 1.58
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.13 0.13 0.13 } }
      geometry Box { size 7.4 3 1.4 }
    }
  ]
}
