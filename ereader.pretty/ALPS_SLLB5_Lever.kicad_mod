(footprint "ALPS_SLLB5_Lever"
  (version 20221018)
  (generator craft-code-systems)
  (layer "F.Cu")
  (descr "ALPS SLLB5 lever + push switch (SLLB510200 / SLLB510100), body 9.5x8.8x2.2mm. Recommended land from the ALPS SLLB5 datasheet (p.491): 4 signal pads 1.0x1.3mm on 2mm pitch (x=-3/-1/+1/+3, y=-0.95) in terminal order 1(CW) / C(COM) / T(PUSH) / 2(CCW); two Ø1.1 locator holes at x=+/-1.9, y=0; side solder lugs. Terminal row on -Y, lever knob toward +Y. Orient/place so the lever reaches the enclosure edge.")
  (tags "ALPS SLLB5 SLLB510200 SLLB510100 lever multi-directional push switch")
