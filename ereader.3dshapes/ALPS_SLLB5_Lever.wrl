#VRML V2.0 utf8
# Simplified stand-in for the ALPS SLLB5 lever+push switch
# (SLLB510200/SLLB510100, body 9.5 x 8.8 x 2.2 mm). Terminal row on the -Y
# edge; body extends +Y with the lever knob on top. Authored in mm;
# footprint references it with scale 0.3937 (= 1/2.54). NOT a full model.

# --- switch body (dark grey), centred over the footprint ---
Transform {
  translation 0 2.4 1.1
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.16 0.16 0.16 } }
      geometry Box { size 9.5 8.8 2.2 }
    }
  ]
}
# --- lever knob on top (yellow-ish) ---
Transform {
  translation 0 3.2 3.0
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.80 0.72 0.20 } }
      geometry Box { size 2.0 3.0 1.6 }
    }
  ]
}
